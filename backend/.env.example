# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port on which the Express server will listen
PORT=3000

# Environment mode: development, staging, or production
# In development, CORS and security features may be relaxed
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MySQL host - use 'mysql' when running in Docker Compose, 'localhost' for local dev
DB_HOST=mysql
DB_PORT=3306

# Database name
DB_NAME=personal_website

# Database user with appropriate permissions
DB_USER=appuser

# Database password - MUST be changed in production!
DB_PASSWORD=AppPass@123

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# Access token secret - used to sign and verify short-lived access tokens
# IMPORTANT: Change this in production! Must be at least 32 characters.
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production-min-32-chars

# Refresh token secret - used to sign and verify long-lived refresh tokens
# IMPORTANT: Change this in production! Must be at least 32 characters.
# Generate with: openssl rand -base64 32
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-32-chars

# How long the access token is valid (e.g., 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN=15m

# How long the refresh token is valid (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Frontend URL that is allowed to make requests to this API
# In development: http://localhost:4200 or http://localhost:3000
# In production: https://yourdomain.com
CORS_ORIGIN=http://localhost:4200

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
# Time window for rate limiting in milliseconds (900000ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of general requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Maximum number of authentication attempts (login/register) per window
AUTH_RATE_LIMIT_MAX=5

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: error, warn, info, http, debug, verbose, silly
LOG_LEVEL=info
